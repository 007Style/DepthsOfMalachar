[node name="Title1" type="Label" parent="TabContainer/Combat/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.4, 0.4, 1)
theme_override_font_sizes/font_size = 16
text = "🛡 Dungeon Exploration & Rooms"

[node name="Desc1" type="Label" parent="TabContainer/Combat/Scroll/VBox"]
layout_mode = 2
text = "• Combat Rooms: Clear all enemy waves to unlock the doors and reveal treasure chests.
• Town / Safe Rooms: Rest to fully heal HP, prepare gear, or defend against occasional town raids.
• Special Rooms: Discover Puzzle Rooms for bonus rewards, Curse Rooms for high-risk gambles, and Mirror Rooms to test yourself against your own reflection.
• Boss Floors: Every 5 floors features mini-bosses, major dungeon lords, or ancient secret bosses!"
autowrap_mode = 2

[node name="HSeparator1" type="HSeparator" parent="TabContainer/Combat/Scroll/VBox"]
layout_mode = 2

[node name="Title2" type="Label" parent="TabContainer/Combat/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 1, 0.6, 1)
theme_override_font_sizes/font_size = 16
text = "💎 Loot & Death Mechanics"

[node name="Desc2" type="Label" parent="TabContainer/Combat/Scroll/VBox"]
layout_mode = 2
text = "• Coins: Copper, Silver, and Gold drop from slain foes to purchase upgrades and shop items.
• Death & Legacy: When Ethari falls in battle, use Revive Crystals to continue immediately, or bank your meta-currencies to permanently strengthen future runs.
• Keep Weapon: At the end of a run, choose a prized weapon to store in your Base Weapon Cabinet."
autowrap_mode = 2

