theme_override_font_sizes/font_size = 16
text = "🏰 Base Hub Facilities"

[node name="Desc1" type="Label" parent="TabContainer/Hub & Meta/Scroll/VBox"]
layout_mode = 2
text = "• Training Grounds: Upgrade permanent stats across all classes (Health, Base Damage, Crit).
• Recruit Quarters: Hire fellow adventurers to fight alongside you in the dungeon.
• Pet Fusion & Altar: Hatch, fuse, and bring loyal combat pets.
• Forge & Base Shop: Craft materials and buy rare consumables.
• Hall of Legends & Spy Network: Inspect past generation triumphs and reveal dungeon intel."
autowrap_mode = 2

[node name="HSeparator1" type="HSeparator" parent="TabContainer/Hub & Meta/Scroll/VBox"]
