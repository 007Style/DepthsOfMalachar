[node name="Title1" type="Label" parent="TabContainer/Basics/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.9, 1, 1)
theme_override_font_sizes/font_size = 16
text = "🕹 Core Controls & Movement"

[node name="Desc1" type="Label" parent="TabContainer/Basics/Scroll/VBox"]
layout_mode = 2
text = "• Virtual Joystick (Left Thumb): Touch and drag anywhere on the left side of your screen to move Ethari.
• Attack Button (Right Bottom): Tap to execute primary weapon swings or projectile shots.
• Abilities 1 & 2 (Right Mid): Trigger your class's unique special active abilities.
• Ultimate Ability (Right Top): Devastating power that charges over time and when dealing damage.
• Stance & Rage Buttons: Switch elemental/combat stances or activate Rage mode when the meter fills."
autowrap_mode = 2

[node name="HSeparator1" type="HSeparator" parent="TabContainer/Basics/Scroll/VBox"]
layout_mode = 2

[node name="Title2" type="Label" parent="TabContainer/Basics/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.3, 1)
theme_override_font_sizes/font_size = 16
text = "⚔ Combo & Rage Systems"

[node name="Desc2" type="Label" parent="TabContainer/Basics/Scroll/VBox"]
layout_mode = 2
text = "• Combo Multiplier: Hitting enemies repeatedly without taking damage increases your combo multiplier (+10% per hit). Taking damage or waiting 3 seconds resets the combo!
• Rage Meter: Dealing and taking damage fills your Rage bar. Once full, unleash Rage for +50% bonus damage and heightened speed for 8 seconds."
autowrap_mode = 2

[node name="Combat" type="TabBar" parent="TabContainer"]
