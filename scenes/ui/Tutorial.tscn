theme_override_colors/font_color = Color(1, 0.7, 0.2, 1)
theme_override_font_sizes/font_size = 16
text = "🏆 15 Playable Classes & Mastery"

[node name="Desc2" type="Label" parent="TabContainer/Hub & Meta/Scroll/VBox"]
layout_mode = 2
text = "Master different archetypes from Warrior, Rogue, Mage, and Paladin to Necromancer and Voidblade. Leveling up class mastery unlocks passive divine traits and powerful new skills!"
